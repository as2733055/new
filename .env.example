# Backend Environment Variables
DATABASE_URL=sqlite:///./messages.db
SECRET_KEY=your-super-secret-key-change-this-in-production-min-32-chars
ENCRYPTION_KEY=your-encryption-key-32-bytes-long-minimum-12345
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
CORS_ORIGINS=["http://localhost:3000","http://localhost","http://localhost:80","http://127.0.0.1"]
ALLOWED_HOSTS=["localhost","127.0.0.1"]

# Frontend Environment Variables
REACT_APP_API_URL=http://localhost:8000
REACT_APP_WS_URL=ws://localhost:8000

# Database (only for PostgreSQL)
POSTGRES_DB=encrypted_messaging
POSTGRES_USER=messaging_user
POSTGRES_PASSWORD=secure-password-change-this

# Flask environment
FLASK_ENV=production
